{
  "datasets": [
    {
      "name": "97dbe6fd",
      "displayName": "olist sales and delivery performance overview",
      "queryLines": [
        "-- Monthly revenue (excluding partial months)\r\n",
        "SELECT * FROM workspace.olist.gold_monthly_revenue\r\n",
        "WHERE month BETWEEN '2017-01-01' AND '2018-08-01' ORDER BY month;\r\n",
        "\r\n",
        "-- Top 10 categories\r\n",
        "SELECT * FROM workspace.olist.gold_category_performance LIMIT 10;\r\n",
        "\r\n",
        "-- Delivery by state\r\n",
        "SELECT * FROM workspace.olist.gold_delivery_by_state;\r\n",
        "\r\n",
        "-- Delay vs review\r\n",
        "SELECT * FROM workspace.olist.gold_delay_vs_review;\r\n",
        "\r\n",
        "-- Repeat rate\r\n",
        "SELECT * FROM workspace.olist.gold_repeat_customers;"
      ]
    },
    {
      "name": "delay_vs_review",
      "displayName": "Olist Delay vs Review",
      "config": {
        "source": "workspace.olist.gold_delay_vs_review",
        "measures": [
          {
            "name": "orders",
            "expr": "SUM(orders)"
          },
          {
            "name": "avg_review_score",
            "expr": "AVG(avg_review_score)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Review scores by delivery delay bucket",
        "dimensions": [
          {
            "name": "delay_bucket",
            "expr": "delay_bucket",
            "displayName": "Delivery Delay"
          }
        ]
      }
    },
    {
      "name": "category_performance",
      "displayName": "Olist Top Categories",
      "config": {
        "source": "SELECT category_english, revenue, orders, items_sold, avg_price FROM workspace.olist.gold_category_performance ORDER BY revenue DESC LIMIT 10",
        "measures": [
          {
            "name": "revenue",
            "expr": "SUM(revenue)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact"
            }
          },
          {
            "name": "orders",
            "expr": "SUM(orders)"
          }
        ],
        "version": "1.1",
        "comment": "Top 10 product categories by revenue",
        "dimensions": [
          {
            "name": "category_english",
            "expr": "category_english",
            "displayName": "Product Category"
          }
        ]
      }
    },
    {
      "name": "seller_performance",
      "displayName": "Olist Top Sellers",
      "config": {
        "source": "SELECT seller_id, seller_state, orders, revenue, avg_review_score, pct_late,\n  ROW_NUMBER() OVER (ORDER BY revenue DESC) AS seller_rank\nFROM workspace.olist.gold_seller_performance ORDER BY revenue DESC LIMIT 10",
        "measures": [
          {
            "name": "orders",
            "expr": "SUM(orders)"
          },
          {
            "name": "revenue",
            "expr": "SUM(revenue)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "none",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_review_score",
            "expr": "AVG(avg_review_score)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "pct_late",
            "expr": "AVG(pct_late)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Top 10 sellers by revenue",
        "dimensions": [
          {
            "name": "seller_rank",
            "expr": "seller_rank",
            "displayName": "Rank"
          },
          {
            "name": "seller_id",
            "expr": "seller_id",
            "displayName": "Seller"
          },
          {
            "name": "seller_state",
            "expr": "seller_state",
            "displayName": "Seller State"
          }
        ]
      }
    },
    {
      "name": "delivery_by_state",
      "displayName": "Olist Delivery by State",
      "config": {
        "source": "workspace.olist.gold_delivery_by_state",
        "measures": [
          {
            "name": "orders",
            "expr": "SUM(orders)"
          },
          {
            "name": "avg_delivery_days",
            "expr": "AVG(avg_delivery_days)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "avg_delay_days",
            "expr": "AVG(avg_delay_days)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "late_orders",
            "expr": "SUM(orders * pct_late / 100.0)"
          },
          {
            "name": "pct_late_overall",
            "expr": "MEASURE(`late_orders`) / MEASURE(`orders`)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "avg_review_score",
            "expr": "AVG(avg_review_score)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Delivery performance and review scores by customer state",
        "dimensions": [
          {
            "name": "customer_state",
            "expr": "customer_state",
            "displayName": "Customer State"
          }
        ]
      }
    },
    {
      "name": "monthly_revenue",
      "displayName": "Olist Monthly Revenue",
      "config": {
        "source": "workspace.olist.gold_monthly_revenue",
        "measures": [
          {
            "name": "orders",
            "expr": "SUM(orders)"
          },
          {
            "name": "revenue",
            "expr": "SUM(revenue)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "max",
                "places": 2.0
              }
            }
          },
          {
            "name": "freight",
            "expr": "SUM(freight)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact"
            }
          },
          {
            "name": "avg_order_value",
            "expr": "MEASURE(`revenue`) / MEASURE(`orders`)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL"
            }
          }
        ],
        "filter": "month >= '2017-01-01' AND month <= '2018-08-01'",
        "version": "1.1",
        "comment": "Monthly Olist revenue excluding the partial first and last months (Jan 2017 - Aug 2018)",
        "dimensions": [
          {
            "name": "month",
            "expr": "month",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          }
        ]
      }
    }
  ],
